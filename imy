
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title></title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: #000;
  overflow: hidden;
  color: #ff3030;
  font-family: "Press Start 2P", monospace;
}

.scene {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  isolation: isolate;
  background:
    radial-gradient(ellipse at 50% 42%, #200606 0%, #090202 48%, #000 100%);
}

/* LIRIK */
.lyrics-area {
  position: absolute;
  top: 40%;
  left: 0;
  width: 100%;
  z-index: 10;
  pointer-events: none;
}

.lyric {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 0;
  width: 92%;
  margin: auto;
  text-align: center;
  color: #ff3030;
  font-family: "Press Start 2P", monospace;
  font-size: clamp(10px, 2vw, 18px);
  line-height: 2.5;
  text-shadow: 0 0 8px red, 0 0 22px #990000;
  min-height: 3em;
}

.letter {
  display: inline-block;
  opacity: 0;
  transform: translateY(10px);
  animation: letterAppear .18s ease-out forwards;
}

@keyframes letterAppear {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.lyric.fade-out {
  animation: lyricExit .45s ease-in forwards;
}

@keyframes lyricExit {
  to {
    opacity: 0;
    transform: translateX(-35px);
  }
}

.final-line {
  font-size: clamp(16px, 4vw, 34px);
  letter-spacing: 2px;
}

/* ILUSTRASI NATAL */
.decor {
  position: absolute;
  z-index: 4;
  font-family: sans-serif;
  user-select: none;
  pointer-events: none;
  filter: drop-shadow(0 0 12px rgba(255, 30, 30, .4));
  animation: floatDecor 3.5s ease-in-out infinite alternate;
}

@keyframes floatDecor {
  from { transform: translateY(0) rotate(-5deg); }
  to { transform: translateY(-16px) rotate(5deg); }
}

.moon {
  top: 12%;
  left: 9%;
  font-size: 35px;
  animation: moonGlow 4s infinite alternate;
}

.phone {
  left: 7%;
  bottom: 12%;
  font-size: clamp(45px, 7vw, 76px);
  animation: phoneRing 3s ease-in-out infinite;
}

.tree {
  right: 6%;
  bottom: 10%;
  font-size: clamp(50px, 8vw, 90px);
  animation: treeGlow 2s ease-in-out infinite alternate;
}

.ghost {
  right: 19%;
  top: 16%;
  font-size: clamp(32px, 5vw, 55px);
  animation: ghostFloat 4s ease-in-out infinite;
}

.santa {
  left: 17%;
  top: 22%;
  font-size: 38px;
}

.gift {
  right: 18%;
  bottom: 19%;
  font-size: 35px;
  animation-delay: .6s;
}

.bell {
  right: 35%;
  top: 12%;
  font-size: 30px;
  animation-delay: 1s;
}

.candle {
  left: 30%;
  bottom: 14%;
  font-size: 32px;
  animation-delay: .3s;
}

.deer {
  right: 8%;
  top: 48%;
  font-size: 34px;
  animation-delay: .8s;
}

.teddy {
  left: 19%;
  top: 53%;
  font-size: 30px;
  animation-delay: .4s;
}

.letter-decor {
  right: 30%;
  bottom: 13%;
  font-size: 34px;
}

.sleigh {
  left: 42%;
  top: 16%;
  font-size: 32px;
}

.snowman {
  right: 32%;
  bottom: 8%;
  font-size: 38px;
}

.socks {
  left: 42%;
  bottom: 11%;
  font-size: 30px;
}

@keyframes phoneRing {
  0%, 72%, 100% { transform: rotate(0); }
  78% { transform: rotate(-12deg); }
  84% { transform: rotate(12deg); }
  90% { transform: rotate(-8deg); }
}

@keyframes treeGlow {
  from { filter: drop-shadow(0 0 5px #650000); }
  to { filter: drop-shadow(0 0 25px red); }
}

@keyframes ghostFloat {
  0%, 100% { transform: translateY(0) rotate(-7deg); }
  50% { transform: translateY(-25px) rotate(7deg); }
}

@keyframes moonGlow {
  from { opacity: .5; }
  to { opacity: 1; filter: drop-shadow(0 0 14px white); }
}

/* SALJU */
.snowflake {
  position: absolute;
  top: -30px;
  z-index: 3;
  color: #fff;
  font-family: sans-serif;
  pointer-events: none;
  text-shadow: 0 0 8px #fff;
  animation: snowfall linear infinite;
}

@keyframes snowfall {
  0% { transform: translate(0, -20px) rotate(0); }
  50% { transform: translate(30px, 50vh) rotate(180deg); }
  100% { transform: translate(-20px, 110vh) rotate(360deg); }
}

/* LAMPU NATAL */
.light-string {
  position: absolute;
  top: 5%;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: space-around;
  z-index: 2;
  font-family: sans-serif;
  font-size: 18px;
}

.light-string span {
  animation: blinkLight 1s infinite alternate;
}

.light-string span:nth-child(even) {
  animation-delay: .5s;
}

@keyframes blinkLight {
  from { opacity: .2; }
  to {
    opacity: 1;
    filter: drop-shadow(0 0 10px red);
  }
}

/* PETASAN */
.fireworks {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 6;
}

.firework {
  position: absolute;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--spark-color);
  box-shadow: 0 0 8px var(--spark-color), 0 0 15px var(--spark-color);
  animation: fireworkBurst 1.5s ease-out forwards;
}

@keyframes fireworkBurst {
  0% {
    opacity: 1;
    transform: translate(0, 0) scale(1);
  }
  70% { opacity: 1; }
  100% {
    opacity: 0;
    transform: translate(var(--dx), var(--dy)) scale(.15);
  }
}

.firework-flash {
  position: absolute;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  background: white;
  animation: flashGlow .65s ease-out forwards;
}

@keyframes flashGlow {
  0% {
    opacity: .9;
    box-shadow:
      0 0 15px 8px white,
      0 0 35px 18px #ff3030;
  }
  100% {
    opacity: 0;
    box-shadow:
      0 0 0 0 transparent,
      0 0 0 0 transparent;
  }
}

/* RESPONSIVE */
@media (max-width: 600px) {
  .lyrics-area { top: 38%; }

  .lyric {
    width: 94%;
    font-size: 10px;
    line-height: 2.7;
  }

  .moon { left: 5%; }
  .ghost { right: 8%; }
  .phone { left: 4%; bottom: 10%; }
  .tree { right: 3%; bottom: 10%; }
  .santa { left: 8%; }
  .teddy { left: 7%; top: 55%; }
  .deer { right: 5%; top: 55%; }
}

@media (prefers-reduced-motion: reduce) {
  .decor, .snowflake, .star {
    animation-duration: 12s;
  }
}
</style>
</head>

<body>
<div class="scene" id="scene">

  <!-- Petasan berada di belakang lirik -->
  <div class="fireworks" id="fireworks"></div>

  <!-- Lampu Natal -->
  <div class="light-string">
    <span>🔴</span><span>🟡</span><span>🔴</span>
    <span>🟢</span><span>🔴</span><span>🟡</span>
    <span>🟢</span><span>🔴</span><span>🟡</span>
  </div>

  <!-- Ilustrasi bergerak -->
  <div class="decor moon">🌙</div>
  <div class="decor phone">☎️</div>
  <div class="decor tree">🎄</div>
  <div class="decor ghost">👻</div>
  <div class="decor santa">🎅🏻</div>
  <div class="decor gift">🎁</div>
  <div class="decor bell">🔔</div>
  <div class="decor candle">🕯️</div>
  <div class="decor deer">🦌</div>
  <div class="decor teddy">🧸</div>
  <div class="decor letter-decor">💌</div>
  <div class="decor sleigh">🛷</div>
  <div class="decor snowman">☃️</div>
  <div class="decor socks">🧦</div>

  <!-- Lirik -->
  <main class="lyrics-area">
    <div class="lyric" id="lyric"></div>
  </main>

</div>

<script>
const lyrics = [
  "So what if I call",
  "And you pick up the phone?",
  "And I use this holiday",
  "To make my way to your ghost",
  "Or what if you’re lonely",
  "And you know I am too?",
  "And I get the chance to say",
  "“Merry Christmas, I miss you”",
  "I MISS YOU"
];

const lyricElement = document.getElementById("lyric");
const scene = document.getElementById("scene");
const fireworks = document.getElementById("fireworks");

let current = 0;

const LETTER_SPEED = 55;
const HOLD_TIME = 1400;
const EXIT_TIME = 450;

function wait(ms) {
  return new Promise(resolve => setTimeout(resolve, ms));
}

/* Salju dan bintang */
function createSnow() {
  const symbols = ["❄", "❅", "❆", "·", "✧"];

  for (let i = 0; i < 100; i++) {
    const flake = document.createElement("span");
    flake.className = "snowflake";
    flake.textContent =
      symbols[Math.floor(Math.random() * symbols.length)];

    flake.style.left = Math.random() * 100 + "%";
    flake.style.fontSize = (7 + Math.random() * 15) + "px";
    flake.style.animationDuration = (6 + Math.random() * 12) + "s";
    flake.style.animationDelay = (-Math.random() * 18) + "s";
    flake.style.opacity = (0.2 + Math.random() * .75).toFixed(2);

    scene.appendChild(flake);
  }

  for (let i = 0; i < 20; i++) {
    const star = document.createElement("span");
    star.className = "star";
    star.textContent = Math.random() > .5 ? "✦" : "✧";
    star.style.left = Math.random() * 100 + "%";
    star.style.top = Math.random() * 100 + "%";
    star.style.fontSize = (8 + Math.random() * 16) + "px";
    star.style.animationDelay = Math.random() * 2 + "s";
    scene.appendChild(star);
  }
}

/* Lirik per huruf */
async function playLyrics() {
  while (true) {
    const text = lyrics[current];

    lyricElement.className = "lyric";
    lyricElement.innerHTML = "";

    if (current === lyrics.length - 1) {
      lyricElement.classList.add("final-line");
    }

    for (const character of text) {
      const span = document.createElement("span");
      span.className = "letter";
      span.textContent = character;

      if (character === " ") {
        span.style.width = ".55em";
      }

      lyricElement.appendChild(span);
      await wait(LETTER_SPEED);
    }

    await wait(current === lyrics.length - 1 ? 2200 : HOLD_TIME);

    lyricElement.classList.add("fade-out");
    await wait(EXIT_TIME);

    current = (current + 1) % lyrics.length;
  }
}

/* PETASAN BERWARNA */
const fireworkColors = [
  "#ff3030",
  "#ffd700",
  "#ffffff",
  "#ff69b4",
  "#00ffff",
  "#ff8c00"
];

function launchFirework() {
  const x = 8 + Math.random() * 84;
  const y = 10 + Math.random() * 45;

  const color = fireworkColors[
    Math.floor(Math.random() * fireworkColors.length)
  ];

  // Kilatan saat ledakan
  const flash = document.createElement("div");
  flash.className = "firework-flash";
  flash.style.left = x + "%";
  flash.style.top = y + "%";
  fireworks.appendChild(flash);

  setTimeout(() => flash.remove(), 700);

  // Percikan menyebar ke segala arah
  const particles = 36;

  for (let i = 0; i < particles; i++) {
    const particle = document.createElement("span");
    particle.className = "firework";

    particle.style.left = x + "%";
    particle.style.top = y + "%";

    const angle = (Math.PI * 2 * i) / particles;
    const distance = 30 + Math.random() * 110;

    particle.style.setProperty(
      "--dx",
      Math.cos(angle) * distance + "px"
    );

    particle.style.setProperty(
      "--dy",
      Math.sin(angle) * distance + "px"
    );

    particle.style.setProperty("--spark-color", color);
    particle.style.animationDuration =
      (1 + Math.random() * .8) + "s";

    fireworks.appendChild(particle);

    setTimeout(() => particle.remove(), 1900);
  }
}

/* Petasan muncul bergantian */
function fireworksLoop() {
  launchFirework();

  setTimeout(
    fireworksLoop,
    800 + Math.random() * 1000
  );
}

/* Mulai semua animasi */
createSnow();
playLyrics();
fireworksLoop();
</script>
</body>
</html>
